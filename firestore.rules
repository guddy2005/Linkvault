rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
    
    // Links collection
    match /links/{linkId} {
      // Anyone can read links (for redirection)
      allow read: if true;
      
      // Only authenticated users can create their own links
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid
                    || request.resource.data.userId == 'guest';
      
      // Only the owner can update/delete their links
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Click subcollection - anyone can create (for tracking)
      match /clicks/{clickId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/links/$(linkId)).data.userId == request.auth.uid;
        allow create: if true;
        allow update, delete: if false;
      }
    }
  }
}
